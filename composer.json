{
  "name": "artisanpack-ui/ecommerce-paypal",
  "description": "PayPal gateway for the ArtisanPack UI ecommerce engine: PayPal, Pay Later, Venmo, cards, Apple Pay, and Google Pay.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "laravel",
    "ecommerce",
    "paypal",
    "payments",
    "payment-gateway",
    "artisanpack-ui"
  ],
  "autoload": {
    "psr-4": {
      "ArtisanPackUI\\EcommercePayPal\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Jacob Martella",
      "email": "me@jacobmartella.com"
    }
  ],
  "require": {
    "php": "^8.3",
    "ext-openssl": "*",
    "illuminate/support": "^12.0|^13.0",
    "illuminate/http": "^12.0|^13.0",
    "artisanpack-ui/ecommerce": "^1.3",
    "artisanpack-ui/core": "^1.0",
    "artisanpack-ui/hooks": "^1.2",
    "moneyphp/money": "^4.1"
  },
  "require-dev": {
    "pestphp/pest": "^4.0",
    "pestphp/pest-plugin-laravel": "^4.0",
    "pestphp/pest-plugin-browser": "^4.0",
    "artisanpack-ui/code-style": "^1.1",
    "artisanpack-ui/code-style-pint": "^1.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "laravel/pint": "^1.26",
    "orchestra/testbench": "^10.2|^11.0",
    "friendsofphp/php-cs-fixer": "^3.75",
    "artisanpack-ui/ecommerce-storefront-livewire": "^1.0",
    "artisanpack-ui/ecommerce-admin-livewire": "^1.0",
    "rebing/graphql-laravel": "^9.0|^10.0"
  },
  "suggest": {
    "artisanpack-ui/ecommerce-storefront-livewire": "Livewire payment drivers, Pay Later messaging, and the account saved-methods page.",
    "artisanpack-ui/ecommerce-admin-livewire": "The PayPal order panel and the settings screen.",
    "livewire/livewire": "Required by both of the above (they pull it in)."
  },
  "scripts": {
    "lint": [
      "./vendor/bin/php-cs-fixer fix --dry-run --diff",
      "./vendor/bin/phpcs"
    ],
    "fix": "./vendor/bin/php-cs-fixer fix",
    "cs": "./vendor/bin/phpcs",
    "cs:fix": "./vendor/bin/phpcbf",
    "test": "./vendor/bin/pest --testsuite=Unit,Feature",
    "test:sandbox": "./vendor/bin/pest --testsuite=Sandbox --group=sandbox",
    "test:browser": [
      "npm run build:browser",
      "./vendor/bin/pest --testsuite=Browser --group=browser --exclude-group=sandbox"
    ],
    "test:browser:sandbox": [
      "npm run build:browser",
      "./vendor/bin/pest --testsuite=Browser --group=sandbox"
    ],
    "ecommerce:verify-satellite": "ecommerce-verify-satellite"
  },
  "config": {
    "sort-packages": false,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ArtisanPackUI\\EcommercePayPal\\EcommercePayPalServiceProvider"
      ]
    }
  }
}
